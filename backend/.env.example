APP_NAME=MOLIDO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=molido
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# AI Configuration (Provider-agnostic)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096
AI_TIMEOUT=30

# Payment Configuration (Provider-agnostic)
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_CALLBACK_URL=

# Feature Flags
CHATBOT_ENABLED=true
AI_WORKFORCE_ENABLED=true
CRM_ENABLED=true
ERP_ENABLED=true
MARKETPLACE_ENABLED=true
PAYMENT_ENABLED=true
SUBSCRIPTION_ENABLED=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@molido.local"
MAIL_FROM_NAME="${APP_NAME}"
